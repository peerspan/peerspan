# Environment for capsule-coord.service. Install as
# /etc/capsule-coord/capsule-coord.env (root:root, mode 0644; it holds no
# secrets). Every variable must be set: the unit passes each one to a flag.

# The coordination address: TCP for the API and relay, UDP for address
# discovery, on the same port. It must be the port hosts reach, the one in
# the address that release bundles and invites name. 0.0.0.0 listens on every
# IPv4 address; use [::]:7400 to accept IPv6 as well. A port below 1024 needs
# CAP_NET_BIND_SERVICE, which install.sh adds to the unit (README.md).
CAPSULE_COORD_LISTEN=0.0.0.0:7400

# Current member hosts per network. 0 disables the limit.
CAPSULE_COORD_MAX_MEMBERS=50

# Network registrations per source address (IPv6 by /64) in any 24 hours.
# 0 disables the limit.
CAPSULE_COORD_MAX_NETWORKS_PER_IP=20

# Relayed datagram bytes per network per UTC calendar month. 0 disables the
# limit.
CAPSULE_COORD_RELAY_BYTES_PER_MONTH=10000000000
